body {
    font-family: Arial, sans-serif;
    margin: 20px;
}

button {
    padding: 8px 15px;
    cursor: pointer;
}

input {
    padding: 8px;
    width: 250px;
    margin-left: 10px;
}

ul {
    list-style: none;
    padding: 0;
    margin-top: 20px;
}

li {
    border: 1px solid #ccc;
    padding: 10px;
    margin-bottom: 8px;
    border-radius: 5px;
}

.error {
    color: red;
    margin-top: 10px;
}
